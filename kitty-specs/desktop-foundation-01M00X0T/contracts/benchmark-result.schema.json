{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-desktop.invalid/schemas/benchmark-result-v1.json",
  "title": "DSH Desktop Benchmark Campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "campaignId",
    "createdAt",
    "controllerRevision",
    "candidateOrderSeed",
    "payloadDigest",
    "profileDigest",
    "fixtureDigest",
    "environment",
    "policy",
    "runs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "campaignId": { "type": "string", "format": "uuid" },
    "createdAt": { "type": "string", "format": "date-time" },
    "controllerRevision": { "$ref": "#/$defs/digest" },
    "candidateOrderSeed": { "type": "integer", "minimum": 0 },
    "payloadDigest": { "$ref": "#/$defs/digest" },
    "profileDigest": { "$ref": "#/$defs/digest" },
    "fixtureDigest": { "$ref": "#/$defs/digest" },
    "environment": { "$ref": "#/$defs/environment" },
    "policy": { "$ref": "#/$defs/policy" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate": {
      "type": "string",
      "enum": ["browser-baseline", "electron", "tauri"]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machineId",
        "hardwareModel",
        "physicalMemoryBytes",
        "architecture",
        "osVersion",
        "osBuild",
        "displayWidthPx",
        "displayHeightPx",
        "displayScale",
        "powerSource",
        "locale",
        "theme",
        "developerToolsEnabled"
      ],
      "properties": {
        "machineId": { "$ref": "#/$defs/digest" },
        "hardwareModel": { "type": "string", "minLength": 1 },
        "physicalMemoryBytes": { "type": "integer", "minimum": 1 },
        "architecture": { "const": "arm64" },
        "osVersion": { "type": "string", "minLength": 1 },
        "osBuild": { "type": "string", "minLength": 1 },
        "displayWidthPx": { "type": "integer", "minimum": 1 },
        "displayHeightPx": { "type": "integer", "minimum": 1 },
        "displayScale": { "type": "number", "exclusiveMinimum": 0 },
        "powerSource": { "enum": ["ac"] },
        "locale": { "type": "string", "minLength": 1 },
        "theme": { "enum": ["light", "dark", "system-fixed"] },
        "developerToolsEnabled": { "const": false }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumLaunchRuns",
        "minimumScenarioRuns",
        "memoryScenarioWeights",
        "tauriAggregateImprovementMinimum",
        "perScenarioMemoryRegressionMaximum",
        "relativeResponseRegressionMaximum",
        "relativeStartupRegressionMaximum",
        "inputPaintP95MaximumMs",
        "inputPaintP99ExclusiveMaximumMs",
        "stallThresholdMs",
        "controlRttP95MaximumMs",
        "warmPromptReadyP95MaximumMs",
        "coldPromptReadyP95MaximumMs",
        "confidenceLevel"
      ],
      "properties": {
        "minimumLaunchRuns": { "type": "integer", "minimum": 30 },
        "minimumScenarioRuns": { "type": "integer", "minimum": 10 },
        "memoryScenarioWeights": {
          "type": "object",
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 },
          "minProperties": 4
        },
        "tauriAggregateImprovementMinimum": { "const": 0.25 },
        "perScenarioMemoryRegressionMaximum": { "const": 0.05 },
        "relativeResponseRegressionMaximum": { "const": 0.10 },
        "relativeStartupRegressionMaximum": { "const": 0.10 },
        "inputPaintP95MaximumMs": { "const": 50 },
        "inputPaintP99ExclusiveMaximumMs": { "const": 100 },
        "stallThresholdMs": { "const": 250 },
        "controlRttP95MaximumMs": { "const": 100 },
        "warmPromptReadyP95MaximumMs": { "const": 1500 },
        "coldPromptReadyP95MaximumMs": { "const": 3000 },
        "confidenceLevel": { "const": 0.95 }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "startUnixMs", "role", "executableDigest", "attributionMethod"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "parentPid": { "type": ["integer", "null"], "minimum": 1 },
        "startUnixMs": { "type": "integer", "minimum": 0 },
        "role": {
          "enum": [
            "shell",
            "renderer",
            "web-content",
            "gpu",
            "network",
            "host",
            "tool-child",
            "helper"
          ]
        },
        "executableDigest": { "$ref": "#/$defs/digest" },
        "attributionMethod": {
          "enum": ["descendant", "shell-metrics", "creation-time-correlation", "explicit-registration"]
        }
      }
    },
    "memoryCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "monotonicMs", "physicalFootprintBytes", "processRssBytes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "monotonicMs": { "type": "number", "minimum": 0 },
        "physicalFootprintBytes": { "type": "integer", "minimum": 0 },
        "processRssBytes": {
          "type": "object",
          "propertyNames": { "pattern": "^[1-9][0-9]*$" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processStartMs",
        "windowVisibleMs",
        "rendererSettledMs",
        "hostConnectedMs",
        "composerOperationalMs",
        "firstSessionReadyMs",
        "class"
      ],
      "properties": {
        "processStartMs": { "const": 0 },
        "windowVisibleMs": { "type": "number", "minimum": 0 },
        "rendererSettledMs": { "type": "number", "minimum": 0 },
        "hostConnectedMs": { "type": "number", "minimum": 0 },
        "composerOperationalMs": { "type": "number", "minimum": 0 },
        "firstSessionReadyMs": { "type": "number", "minimum": 0 },
        "class": { "enum": ["cold", "warm", "first-isolated"] }
      }
    },
    "latencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputToPaintMs", "controlRequestAckRttMs", "frameGapsMs"],
      "properties": {
        "inputToPaintMs": { "$ref": "#/$defs/numberSamples" },
        "controlRequestAckRttMs": { "$ref": "#/$defs/numberSamples" },
        "frameGapsMs": { "$ref": "#/$defs/numberSamples" }
      }
    },
    "numberSamples": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number", "minimum": 0 }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedFrameCount",
        "observedFrameCount",
        "duplicateFrameCount",
        "outOfOrderFrameCount",
        "finalStateDigest",
        "expectedFinalStateDigest",
        "applicationTcpListeners"
      ],
      "properties": {
        "expectedFrameCount": { "type": "integer", "minimum": 0 },
        "observedFrameCount": { "type": "integer", "minimum": 0 },
        "duplicateFrameCount": { "type": "integer", "minimum": 0 },
        "outOfOrderFrameCount": { "type": "integer", "minimum": 0 },
        "finalStateDigest": { "$ref": "#/$defs/digest" },
        "expectedFinalStateDigest": { "$ref": "#/$defs/digest" },
        "applicationTcpListeners": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "ordinal",
        "candidate",
        "scenario",
        "payloadDigest",
        "profileDigest",
        "fixtureDigest",
        "startedAt",
        "processes",
        "memory",
        "startup",
        "latencies",
        "integrity",
        "thermalState",
        "valid",
        "invalidationReasons"
      ],
      "properties": {
        "runId": { "type": "string", "format": "uuid" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "candidate": { "$ref": "#/$defs/candidate" },
        "scenario": { "type": "string", "minLength": 1 },
        "payloadDigest": { "$ref": "#/$defs/digest" },
        "profileDigest": { "$ref": "#/$defs/digest" },
        "fixtureDigest": { "$ref": "#/$defs/digest" },
        "startedAt": { "type": "string", "format": "date-time" },
        "processes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/process" }
        },
        "memory": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/memoryCheckpoint" }
        },
        "startup": { "$ref": "#/$defs/startup" },
        "latencies": { "$ref": "#/$defs/latencies" },
        "integrity": { "$ref": "#/$defs/integrity" },
        "thermalState": { "enum": ["nominal", "fair", "serious", "critical"] },
        "valid": { "type": "boolean" },
        "invalidationReasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "valid": { "const": true } } },
          "then": { "properties": { "invalidationReasons": { "maxItems": 0 } } },
          "else": { "properties": { "invalidationReasons": { "minItems": 1 } } }
        }
      ]
    }
  }
}
