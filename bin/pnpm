#!/bin/sh
set -eu

if [ -z "${HARNESS_DESKTOP_ELECTRON:-}" ]; then
  echo "HARNESS_DESKTOP_ELECTRON is required" >&2
  exit 1
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export HARNESS_DESKTOP_ORIGINAL_NODE_OPTIONS="${NODE_OPTIONS:-}"
export NODE_OPTIONS="--require=\"$script_dir/clear-electron-run-as-node.cjs\"${NODE_OPTIONS:+ $NODE_OPTIONS}"
ELECTRON_RUN_AS_NODE=1 exec "$HARNESS_DESKTOP_ELECTRON" "$script_dir/../node_modules/pnpm/bin/pnpm.mjs" "$@"
